/go/*.test
/go/bin/
/go/pkg/
/go/coverage.out
/go/coverage.html
/go/*.prof
/go/pprof/

# Rust Cargo build output and metadata
/rust/target/

# Node package installations and generated output
node_modules/
/typescript/.npm/
/typescript/dist/
/typescript/.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

